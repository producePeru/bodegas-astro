---
import Layout from "../layouts/Layout.astro";
import BrandCard from "../components/BrandCard.astro";
import { empresa } from "../data/marcas";
---

<Layout title={`${empresa.nombre} — ${empresa.slogan}`}>
  <section class="max-w-6xl mx-auto px-4 text-center">
    <h1 class="font-display text-2xl md:text-3xl text-[#00a6db] tracking-wide">
      {empresa.slogan}
    </h1>

    <div id="buscador" class="mt-6 max-w-sm mx-auto">
      <div class="relative">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="w-4 h-4 text-[#00a1d4] absolute left-4 top-1/2 -translate-y-1/2"
        >
          <path
            d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
          ></path>
        </svg>
        <input
          id="campo-busqueda"
          type="search"
          placeholder="Buscar marca aliada..."
          autocomplete="off"
          class="w-full pl-11 pr-4 py-2.5 rounded-full border border-stone-200 bg-white text-sm text-stone-600 focus:border-[#00a1d4] focus:ring-2 focus:ring-[#00a1d4]/20 outline-none transition placeholder:text-stone-400"
        />
      </div>
      <p id="sin-resultados" class="hidden mt-4 text-sm text-[#00a6db]">
        No se encontraron marcas.
      </p>
    </div>
  </section>

  <section class="w-full px-4 md:px-8 py-10 md:py-14">
    <div
      id="grid-marcas"
      class="w-full mx-auto grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-4"
    >
      <div class="col-span-full flex flex-col items-center justify-center py-24 gap-3">
        <div class="flex gap-1.5">
          <span class="w-2 h-2 rounded-full bg-[#00a6db] animate-bounce" style="animation-delay: 0ms"></span>
          <span class="w-2 h-2 rounded-full bg-[#00a6db] animate-bounce" style="animation-delay: 150ms"></span>
          <span class="w-2 h-2 rounded-full bg-[#00a6db] animate-bounce" style="animation-delay: 300ms"></span>
        </div>
        <p class="text-xs text-stone-400 tracking-wide uppercase font-medium">Cargando marcas aliadas</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { fetchTiendas } from '../services/api';

  function renderSkeletons() {
    const grid = document.getElementById("grid-marcas");
    if (!grid) return;
    grid.innerHTML = Array(8).fill(`
      <div class="bg-white border border-stone-200/60 rounded-lg overflow-hidden">
        <div class="h-28 md:h-72 bg-gradient-to-br from-stone-50 to-stone-100 flex items-center justify-center p-4">
          <div class="w-14 h-14 md:w-24 md:h-24 rounded-full bg-stone-200/70 animate-pulse"></div>
        </div>
        <div class="h-10 md:h-11 px-2 border-t border-stone-100 flex items-center justify-center">
          <div class="h-3.5 bg-stone-200/70 rounded-full w-2/3 animate-pulse"></div>
        </div>
      </div>
    `).join('');
  }

  async function cargarTiendas() {
    const grid = document.getElementById("grid-marcas");
    if (!grid) return;

    renderSkeletons();

    try {
      const resultado = await fetchTiendas();
      const tiendas = resultado.data || [];

      if (tiendas.length === 0) {
        grid.innerHTML = '<div class="col-span-full text-center text-stone-400">No hay tiendas disponibles.</div>';
        return;
      }

      grid.innerHTML = tiendas.map((tienda) => `
        <a href="/marca/${tienda.id}" class="group flex flex-col bg-white border border-stone-200 rounded-lg hover:border-[#e31d1a]/50 hover:shadow-md transition-all overflow-hidden h-full">
          <div class="w-full h-28 md:h-72 flex items-center justify-center text-stone-500 group-hover:text-[#00a6db] transition-colors p-4">
            <img
              src="${tienda.imagen}"
              alt="Logo de ${tienda.nombre}"
              class="max-w-[75%] md:max-w-[85%] max-h-full md:max-h-[80%] object-contain grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 transition-all"
              loading="lazy"
              onerror="this.parentElement.innerHTML='<span class=\\'font-body font-semibold text-center leading-tight text-sm md:text-base\\'>${tienda.nombre}</span>'"
            />
          </div>
          <span class="w-full h-10 md:h-11 flex items-center justify-center text-center text-xs md:text-sm font-medium text-stone-600 border-t border-stone-100 group-hover:text-[#e31d1a] group-hover:border-[#e31d1a]/30 transition-colors truncate px-2 shrink-0">
            ${tienda.nombre}
          </span>
        </a>
      `).join('');

    } catch (error) {
      grid.innerHTML = '<div class="col-span-full text-center text-red-500">Error al cargar las tiendas. Intenta nuevamente.</div>';
      console.error('Error fetching tiendas:', error);
    }
  }

  function initBuscador() {
    const grid = document.getElementById("grid-marcas");
    const campo = document.getElementById("campo-busqueda");
    const sinResultados = document.getElementById("sin-resultados");
    if (!grid || !campo) return;

    campo.addEventListener("input", (e) => {
      const termino = e.target.value.trim().toLowerCase();
      let visibles = 0;
      grid.querySelectorAll("a").forEach((card) => {
        const coincide = !termino || card.textContent.toLowerCase().includes(termino);
        card.style.display = coincide ? "" : "none";
        if (coincide) visibles++;
      });
      sinResultados?.classList.toggle("hidden", visibles > 0);
    });
  }

  cargarTiendas();
  initBuscador();

  document.addEventListener("astro:page-load", () => {
    cargarTiendas();
    initBuscador();
  });

  function handleBrandClick(e) {
    const link = e.target.closest('#grid-marcas a');
    if (!link) return;

    e.preventDefault();
    const href = link.getAttribute('href');

    const overlay = document.createElement('div');
    overlay.id = 'nav-loading';
    overlay.className = 'fixed inset-0 z-50 flex items-center justify-center bg-white/90 backdrop-blur-sm';
    overlay.innerHTML = `
      <div class="flex flex-col items-center gap-4">
        <div class="relative w-14 h-14">
          <div class="absolute inset-0 rounded-full border-4 border-stone-200"></div>
          <div class="absolute inset-0 rounded-full border-4 border-[#00a6db] border-t-transparent animate-spin"></div>
        </div>
        <p class="text-sm text-stone-500 font-medium tracking-wide">Cargando detalle...</p>
      </div>
    `;
    document.body.appendChild(overlay);

    setTimeout(() => {
      window.location.href = href;
    }, 500);
  }

  document.addEventListener('click', handleBrandClick);
  document.addEventListener("astro:page-load", () => {
    cargarTiendas();
    initBuscador();
    document.addEventListener('click', handleBrandClick);
  });
</script>
